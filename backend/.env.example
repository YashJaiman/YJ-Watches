# Server Configuration
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example for local: mongodb://localhost:27017/yj-watches
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/yj-watches?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/yj-watches

# JWT Secret Key (Generate a strong random string for production)
JWT_SECRET=super_secret_jwt_key_example

# CORS Configuration
# Set to your frontend deployment URL in production (e.g., https://your-frontend.vercel.app)
# For local development with live server, typically http://127.0.0.1:5500
CORS_ORIGIN=http://127.0.0.1:5500
